{
  "name": "ajedrez-inscripciones",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "db:create": "wrangler d1 create ajedrez-inscripciones-db",
    "db:init": "wrangler d1 execute ajedrez-inscripciones-db --file=schema.sql",
    "db:init:remote": "wrangler d1 execute ajedrez-inscripciones-db --remote --file=schema.sql"
  },
  "devDependencies": {
    "wrangler": "^3.90.0"
  }
}
