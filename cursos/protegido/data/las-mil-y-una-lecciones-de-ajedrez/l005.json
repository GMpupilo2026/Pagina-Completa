bpn2/3p4/2PP4/2N1PN2/PPQ1BPPP/R1BR2K1 b - - 9 9","gap":false},{"n":9,"color":"b","san":"Qe7","uci":"d8e7","nag":"","comentario":"","fen":"r1b1r1k1/pp1nqppp/2pbpn2/3p4/2PP4/2N1PN2/PPQ1BPPP/R1BR2K1 w - - 10 10","gap":false},{"n":10,"color":"w","san":"h3","uci":"h2h3","nag":"","comentario":"","fen":"r1b1r1k1/pp1nqppp/2pbpn2/3p4/2PP4/2N1PN1P/PPQ1BPP1/R1BR2K1 b - - 0 10","gap":false},{"n":10,"color":"b","san":"b6","uci":"b7b6","nag":"","comentario":"Con esta jugada, las negras pretender resolver el problema del desarrollo de su alfil de casillas blancas, su principal dificultad en este momento. Existía otra posibilidad para alcanzar este objetivo, preparando el avance...e6-e7 para lo cual deben antes cambiar en c4, por ejemplo: (10...dxc4 11.Axc4 a6 (11...e5 12.Cg5 Tf8 13.d5 es algo molesto) 12.e4 e5 13.Ae3 exd4 14.Cxd4 Ce5)","fen":"r1b1r1k1/p2nqppp/1ppbpn2/3p4/2PP4/2N1PN1P/PPQ1BPP1/R1BR2K1 w - - 0 11","gap":false},{"n":11,"color":"w","san":"e4","uci":"e3e4","nag":"","comentario":"","fen":"r1b1r1k1/p2nqppp/1ppbpn2/3p4/2PPP3/2N2N1P/PPQ1BPP1/R1BR2K1 b - - 0 11","gap":false},{"n":11,"color":"b","san":"dxe4","uci":"d5e4","nag":"","comentario":"","fen":"r1b1r1k1/p2nqppp/1ppbpn2/8/2PPp3/2N2N1P/PPQ1BPP1/R1BR2K1 w - - 0 12","gap":false},{"n":12,"color":"w","san":"Nxe4","uci":"c3e4","nag":"","comentario":"","fen":"r1b1r1k1/p2nqppp/1ppbpn2/8/2PPN3/5N1P/PPQ1BPP1/R1BR2K1 b - - 0 12","gap":false},{"n":12,"color":"b","san":"Nxe4","uci":"f6e4","nag":"","comentario":"","fen":"r1b1r1k1/p2nqppp/1ppbp3/8/2PPn3/5N1P/PPQ1BPP1/R1BR2K1 w - - 0 13","gap":false},{"n":13,"color":"w","san":"Qxe4","uci":"c2e4","nag":"","comentario":"","fen":"r1b1r1k1/p2nqppp/1ppbp3/8/2PPQ3/5N1P/PP2BPP1/R1BR2K1 b - - 0 13","gap":false},{"n":13,"color":"b","san":"Bb7","uci":"c8b7","nag":"","comentario":"","fen":"r3r1k1/pb1nqppp/1ppbp3/8/2PPQ3/5N1P/PP2BPP1/R1BR2K1 w - - 1 14","gap":false},{"n":14,"color":"w","san":"Bf4","uci":"c1f4","nag":"","comentario":"","fen":"r3r1k1/pb1nqppp/1ppbp3/8/2PPQB2/5N1P/PP2BPP1/R2R2K1 b - - 2 14","gap":false},{"n":14,"color":"b","san":"Rad8","uci":"a8d8","nag":"","comentario":"(Sería peor 14...c5 15.Axd6 Axe4 16.Axe7 Txe7 17.dxc5 Cxc5 18.b4 Ca4 19.Tac1 y las blancas tienen ventaja por su mayoría de peones en el flanco de dama. 14...Axf4 15.Dxf4 c5 tampoco resuelve todos los problemas a causa de 16.Dc7 Cf6 17.Dxe7 Txe7 18.dxc5 bxc5 19.Ce5 con una pequeña ventaja para las blancas.)","fen":"3rr1k1/pb1nqppp/1ppbp3/8/2PPQB2/5N1P/PP2BPP1/R2R2K1 w - - 3 15","gap":false},{"n":15,"color":"w","san":"Bxd6","uci":"f4d6","nag":"","comentario":"(Sería peor 15.Ce5 Cf6 16.De3 c5=)","fen":"3rr1k1/pb1nqppp/1ppBp3/8/2PPQ3/5N1P/PP2BPP1/R2R2K1 b - - 0 15","gap":false},{"n":15,"color":"b","san":"Qxd6","uci":"e7d6","nag":"","comentario":"","fen":"3rr1k1/pb1n1ppp/1ppqp3/8/2PPQ3/5N1P/PP2BPP1/R2R2K1 w - - 0 16","gap":false},{"n":16,"color":"w","san":"Ne5","uci":"f3e5","nag":"","comentario":"","fen":"3rr1k1/pb1n1ppp/1ppqp3/4N3/2PPQ3/7P/PP2BPP1/R2R2K1 b - - 1 16","gap":false},{"n":16,"color":"b","san":"Nxe5","uci":"d7e5","nag":"","comentario":"(Seguramente era algo mejor 16...Cf6 17.De3 c5 18.dxc5 Dxc5 19.Dxc5 bxc5 20.f3 aunque también aquí las blancas tienen una pequeña ventaja.)","fen":"3rr1k1/pb3ppp/1ppqp3/4n3/2PPQ3/7P/PP2BPP1/R2R2K1 w - - 0 17","gap":false},{"n":17,"color":"w","san":"dxe5","uci":"d4e5","nag":"","comentario":"","fen":"3rr1k1/pb3ppp/1ppqp3/4P3/2P1Q3/7P/PP2BPP1/R2R2K1 b - - 0 17","gap":false},{"n":17,"color":"b","san":"Qc7","uci":"d6c7","nag":"","comentario":"Las negras solo necesitan una jugada más (...c5) para resolver todos sus problemas, pero como veremos, Karpov con una estrategia magnífica, impedirá tal jugada durante toda la partida.","fen":"3rr1k1/pbq2ppp/1pp1p3/4P3/2P1Q3/7P/PP2BPP1/R2R2K1 w - - 1 18","gap":false},{"n":18,"color":"w","san":"Bf3","uci":"e2f3","nag":"","comentario":"","fen":"3rr1k1/pbq2ppp/1pp1p3/4P3/2P1Q3/5B1P/PP3PP1/R2R2K1 b - - 2 18","gap":false},{"n":18,"color":"b","san":"Ba8","uci":"b7a8","nag":"","comentario":"","fen":"b2rr1k1/p1q2ppp/1pp1p3/4P3/2P1Q3/5B1P/PP3PP1/R2R2K1 w - - 3 19","gap":false},{"n":19,"color":"w","san":"Rxd8","uci":"d1d8","nag":"!","comentario":"","fen":"b2Rr1k1/p1q2ppp/1pp1p3/4P3/2P1Q3/5B1P/PP3PP1/R5K1 b - - 0 19","gap":false},{"n":19,"color":"b","san":"Rxd8","uci":"e8d8","nag":"","comentario":"","fen":"b2r2k1/p1q2ppp/1pp1p3/4P3/2P1Q3/5B1P/PP3PP1/R5K1 w - - 0 20","gap":false},{"n":20,"color":"w","san":"Rd1","uci":"a1d1","nag":"","comentario":"El problema de esta maniobra tan natural, es que pierde un peón. Pero Karpov ha visto lejos y sabe que tendrá compensación suficiente por la mala posición del alfil negro.","fen":"b2r2k1/p1q2ppp/1pp1p3/4P3/2P1Q3/5B1P/PP3PP1/3R2K1 b - - 1 20","gap":false},{"n":20,"color":"b","san":"Rxd1+","uci":"d8d1","nag":"","comentario":"(20...c5? sería muy malo a causa de 21.Txd8+ Dxd8 22.Dxa8+-)","fen":"b5k1/p1q2ppp/1pp1p3/4P3/2P1Q3/5B1P/PP3PP1/3r2K1 w - - 0 21","gap":false},{"n":21,"color":"w","san":"Bxd1","uci":"f3d1","nag":"","comentario":"","fen":"b5k1/p1q2ppp/1pp1p3/4P3/2P1Q3/7P/PP3PP1/3B2K1 b - - 0 21","gap":false},{"n":21,"color":"b","san":"Qd8","uci":"c7d8","nag":"","comentario":"","fen":"b2q2k1/p4ppp/1pp1p3/4P3/2P1Q3/7P/PP3PP1/3B2K1 w - - 1 22","gap":false},{"n":22,"color":"w","san":"Bf3","uci":"d1f3","nag":"","comentario":"","fen":"b2q2k1/p4ppp/1pp1p3/4P3/2P1Q3/5B1P/PP3PP1/6K1 b - - 2 22","gap":false},{"n":22,"color":"b","san":"Qd2","uci":"d8d2","nag":"","comentario":"Esta era la razón para desconfiar del cambio de torres. Las negras ganan un peón, pero siguen estando mal.","fen":"b5k1/p4ppp/1pp1p3/4P3/2P1Q3/5B1P/PP1q1PP1/6K1 w - - 3 23","gap":false},{"n":23,"color":"w","san":"b3","uci":"b2b3","nag":"","comentario":"","fen":"b5k1/p4ppp/1pp1p3/4P3/2P1Q3/1P3B1P/P2q1PP1/6K1 b - - 0 23","gap":false},{"n":23,"color":"b","san":"Qxa2","uci":"d2a2","nag":"","comentario":"","fen":"b5k1/p4ppp/1pp1p3/4P3/2P1Q3/1P3B1P/q4PP1/6K1 w - - 0 24","gap":false},{"n":24,"color":"w","san":"b4","uci":"b3b4","nag":"!","comentario":"(falla 24.Dd4 Da3 25.Dd8+ (25.Dd7 Da1+! 26.Rh2 Dxe5+ 27.g3 Db8!) 25...Df8)","fen":"b5k1/p4ppp/1pp1p3/4P3/1PP1Q3/5B1P/q4PP1/6K1 b - - 0 24","gap":false},{"n":24,"color":"b","san":"Qa1+","uci":"a2a1","nag":"","comentario":"(Pero ahora si 24...a6 25.Dd4 Db1+ 26.Rh2+- las blancas ganan.)","fen":"b5k1/p4ppp/1pp1p3/4P3/1PP1Q3/5B1P/5PP1/q5K1 w - - 1 25","gap":false},{"n":25,"color":"w","san":"Kh2","uci":"g1h2","nag":"","comentario":"","fen":"b5k1/p4ppp/1pp1p3/4P3/1PP1Q3/5B1P/5PPK/q7 b - - 2 25","gap":false},{"n":25,"color":"b","san":"Qa6","uci":"a1a6","nag":"","comentario":"(Las negras no aciertan con la mejor defensa, que consistía en 25...Da3! 26.c5! (si 26.b5 Dc5 27.bxc6 g6 y las blancas no pueden hacer progresos.) 26...Dc3 27.cxb6 axb6 28.b5 g6 29.bxc6 b5 con buenas posibilidades de tablas.)","fen":"b5k1/p4ppp/qpp1p3/4P3/1PP1Q3/5B1P/5PPK/8 w - - 3 26","gap":false},{"n":26,"color":"w","san":"Qd4","uci":"e4d4","nag":"","comentario":"Mucho mejor que la tentadora 26.b5","fen":"b5k1/p4ppp/qpp1p3/4P3/1PPQ4/5B1P/5PPK/8 b - - 4 26","gap":false},{"n":26,"color":"b","san":"Qc8","uci":"a6c8","nag":"","comentario":"27.bxc6 g6 26...Dc8","fen":"b1q3k1/p4ppp/1pp1p3/4P3/1PPQ4/5B1P/5PPK/8 w - - 5 27","gap":false},{"n":27,"color":"w","san":"c5","uci":"c4c5","nag":"!","comentario":"La clave de toda la maniobra. El alfil negro permanece encerrado.","fen":"b1q3k1/p4ppp/1pp1p3/2P1P3/1P1Q4/5B1P/5PPK/8 b - - 0 27","gap":false},{"n":27,"color":"b","san":"bxc5","uci":"b6c5","nag":"","comentario":"(27...b5 28.Dd6 deja a las blancas con un dominio total. Tal vez la mejor defensa fuese no tocar de momento los peones, con 27...Db8 aunque tras 28.g3 la ventaja blanca sería clara.)","fen":"b1q3k1/p4ppp/2p1p3/2p1P3/1P1Q4/5B1P/5PPK/8 w - - 0 28","gap":false},{"n":28,"color":"w","san":"Qxc5","uci":"d4c5","nag":"","comentario":"","fen":"b1q3k1/p4ppp/2p1p3/2Q1P3/1P6/5B1P/5PPK/8 b - - 0 28","gap":false},{"n":28,"color":"b","san":"a6","uci":"a7a6","nag":"","comentario":"(No hay tiempo para 28...Db8 29.g3 Db6 30.Dxb6 axb6 31.b5 Rf8 (31.