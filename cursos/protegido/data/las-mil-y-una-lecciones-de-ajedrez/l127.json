ta demasiado del centro 14...Ce7 15.d5 exd5 16.exd5 Cf5; o 14...Tc8 merecen consideración.)","fen":"r2q1rk1/pb3ppp/1p2p3/n7/2BPP3/5N2/P2Q1PPP/3RR1K1 w - - 4 15","gap":false},{"n":15,"color":"w","san":"Bd3","uci":"c4d3","nag":"","comentario":"","fen":"r2q1rk1/pb3ppp/1p2p3/n7/3PP3/3B1N2/P2Q1PPP/3RR1K1 b - - 5 15","gap":false},{"n":15,"color":"b","san":"Rc8","uci":"a8c8","nag":"","comentario":"","fen":"2rq1rk1/pb3ppp/1p2p3/n7/3PP3/3B1N2/P2Q1PPP/3RR1K1 w - - 6 16","gap":false},{"n":16,"color":"w","san":"d5","uci":"d4d5","nag":"!","comentario":"","fen":"2rq1rk1/pb3ppp/1p2p3/n2P4/4P3/3B1N2/P2Q1PPP/3RR1K1 b - - 0 16","gap":false},{"n":16,"color":"b","san":"exd5","uci":"e6d5","nag":"","comentario":"(Posiblemente sea mejor 16...Dd6!? 17.dxe6 (17.De2 e5) 17...fxe6 18.Ab5!)","fen":"2rq1rk1/pb3ppp/1p6/n2p4/4P3/3B1N2/P2Q1PPP/3RR1K1 w - - 0 17","gap":false},{"n":17,"color":"w","san":"e5","uci":"e4e5","nag":"!","comentario":"Con este sacrificio de peón, preparado de antemano por Polugaevsky, las blancas obstruyen la diagonal del alfil negro y logran una buena casilla en d4, obteniendo muy buenas posibilidades de ataque.","fen":"2rq1rk1/pb3ppp/1p6/n2pP3/8/3B1N2/P2Q1PPP/3RR1K1 b - - 0 17","gap":false},{"n":17,"color":"b","san":"Nc4","uci":"a5c4","nag":"","comentario":"(17...De7 18.Cd4±; 17...h6 18.Df4 Cc6 19.Df5 g6 20.Dg4± Popov,N-Rumiancev,G. URSS 1978/)","fen":"2rq1rk1/pb3ppp/1p6/3pP3/2n5/3B1N2/P2Q1PPP/3RR1K1 w - - 1 18","gap":false},{"n":18,"color":"w","san":"Qf4","uci":"d2f4","nag":"","comentario":"","fen":"2rq1rk1/pb3ppp/1p6/3pP3/2n2Q2/3B1N2/P4PPP/3RR1K1 b - - 2 18","gap":false},{"n":18,"color":"b","san":"Nb2","uci":"c4b2","nag":"","comentario":"(Tal intenta cambiar el peligroso alfil blanco, pero ya es tarde. De todas formas 18...h6 19.Df5 g6 20.Dh3 Rg7 21.e6 era muy favorable a las blancas)","fen":"2rq1rk1/pb3ppp/1p6/3pP3/5Q2/3B1N2/Pn3PPP/3RR1K1 w - - 3 19","gap":false},{"n":19,"color":"w","san":"Bxh7+","uci":"d3h7","nag":"!","comentario":"","fen":"2rq1rk1/pb3ppB/1p6/3pP3/5Q2/5N2/Pn3PPP/3RR1K1 b - - 0 19","gap":false},{"n":19,"color":"b","san":"Kxh7","uci":"g8h7","nag":"","comentario":"","fen":"2rq1r2/pb3ppk/1p6/3pP3/5Q2/5N2/Pn3PPP/3RR1K1 w - - 0 20","gap":false},{"n":20,"color":"w","san":"Ng5+","uci":"f3g5","nag":"","comentario":"","fen":"2rq1r2/pb3ppk/1p6/3pP1N1/5Q2/8/Pn3PPP/3RR1K1 b - - 1 20","gap":false},{"n":20,"color":"b","san":"Kg6","uci":"h7g6","nag":"","comentario":"(Si 20...Rg8 21.Dh4 Te8 22.Dh7+ Rf8 23.e6! dejaría a las negras sin defensa, pues si 23...Dxg5? 24.e7+ da mate.)","fen":"2rq1r2/pb3pp1/1p4k1/3pP1N1/5Q2/8/Pn3PPP/3RR1K1 w - - 2 21","gap":false},{"n":21,"color":"w","san":"h4","uci":"h2h4","nag":"!!","comentario":"(La clave. La amenaza es 22.h5 Rh5 23.g4 Rg6 25.Df5 Rh6 26.Dh7 Rg5 27.Dh5 Rf4 28.Df5#)","fen":"2rq1r2/pb3pp1/1p4k1/3pP1N1/5Q1P/8/Pn3PP1/3RR1K1 b - - 0 21","gap":false},{"n":21,"color":"b","san":"Rc4","uci":"c8c4","nag":"","comentario":"(21...f5 22.Td4! ; 21...Dd7 22.e6 fxe6 23.Dg4 Tf6 24.Cxe6+ Rh6 25.Te5 g6 26.Dg5+)","fen":"3q1r2/pb3pp1/1p4k1/3pP1N1/2r2Q1P/8/Pn3PP1/3RR1K1 w - - 1 22","gap":false},{"n":22,"color":"w","san":"h5+","uci":"h4h5","nag":"","comentario":"","fen":"3q1r2/pb3pp1/1p4k1/3pP1NP/2r2Q2/8/Pn3PP1/3RR1K1 b - - 0 22","gap":false},{"n":22,"color":"b","san":"Kh6","uci":"g6h6","nag":"","comentario":"","fen":"3q1r2/pb3pp1/1p5k/3pP1NP/2r2Q2/8/Pn3PP1/3RR1K1 w - - 1 23","gap":false},{"n":23,"color":"w","san":"Nxf7+","uci":"g5f7","nag":"","comentario":"","fen":"3q1r2/pb3Np1/1p5k/3pP2P/2r2Q2/8/Pn3PP1/3RR1K1 b - - 0 23","gap":false},{"n":23,"color":"b","san":"Kh7","uci":"h6h7","nag":"","comentario":"","fen":"3q1r2/pb3Npk/1p6/3pP2P/2r2Q2/8/Pn3PP1/3RR1K1 w - - 1 24","gap":false},{"n":24,"color":"w","san":"Qf5+","uci":"f4f5","nag":"","comentario":"","fen":"3q1r2/pb3Npk/1p6/3pPQ1P/2r5/8/Pn3PP1/3RR1K1 b - - 2 24","gap":false},{"n":24,"color":"b","san":"Kg8","uci":"h7g8","nag":"","comentario":"","fen":"3q1rk1/pb3Np1/1p6/3pPQ1P/2r5/8/Pn3PP1/3RR1K1 w - - 3 25","gap":false},{"n":25,"color":"w","san":"e6","uci":"e5