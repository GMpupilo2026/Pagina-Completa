{
	"name": "orange-water-b162",
	"main": "worker.js",
	"compatibility_date": "2025-06-05",
	"assets": {
		"directory": "./",
		"binding": "ASSETS",
		// El worker corre ANTES que los archivos solo en estas dos carpetas: es
		// el candado del contenido de los cursos (ver worker.js). Sin esta
		// línea Cloudflare sirve el archivo directo y el candado no existe,
		// sin dar ningún error. Todo lo demás se sirve como siempre.
		"run_worker_first": ["/cursos/protegido/*", "/cursos/recursos/*"]
	}
}
